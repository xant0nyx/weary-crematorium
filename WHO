if (HAL_I2C_Mem_Read(&hi2c1, mag_addr, reg_who_am_i, I2C_MEMADD_SIZE_8BIT, &val_who_am_i, 1, 100) == HAL_OK) {
    printf("Registro WHO_AM_I_M: 0x%02X\r\n", val_who_am_i);
    if(val_who_am_i == 0x40) {
        printf("Sensor LSM303AGR detectado correctamente.\r\n");
